PORT=3000
# Create a project at https://web3.okx.com/onchainos/dev-portal/project
# then fill these (never commit real values to git):
OKX_ACCESS_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Only if your portal shows one (newer projects). Optional.
OKX_PROJECT_ID=
# X Layer wallet that receives x402 payments (0x...). Empty = paid routes stay FREE.
PAY_TO_ADDRESS=
# On Render, set this to your public host, e.g. uzam-m3pi.onrender.com
# Local dev: leave empty (localhost protection stays on)
ALLOWED_HOSTS=
# NODE_ENV=production is set automatically by Render; with it, ALLOWED_HOSTS is required at boot.
# Legacy alt names accepted as fallback (prefer the three above):
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=
